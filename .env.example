# Local development placeholders only. Never put real credentials here.
NEAR_NETWORK=testnet
NEAR_CONTRACT_ID=manextech.testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
PORT=3000
AGENT_API_TOKEN=replace-with-a-unique-random-token-of-at-least-32-url-safe-characters
NEAR_SIGNER_ACCOUNT_ID=manex-agent.testnet
NEAR_SIGNER_PRIVATE_KEY=ed25519:replace-with-agent-request-execution-key
NEAR_APPROVAL_SIGNER_PRIVATE_KEY=ed25519:replace-with-agent-approve-spend-only-key
NEAR_EXPIRY_SIGNER_PRIVATE_KEY=ed25519:replace-with-agent-expire-payment-only-key
EXPIRY_MONITOR_INTERVAL_MS=15000
TAPPROVED_IDEMPOTENCY_PATH=.tapproved/idempotency.json
# Optional example agent client settings; use a unique key for each new payment intent.
# TAPPROVED_RELAY_URL=http://127.0.0.1:3000
# TAPPROVED_IDEMPOTENCY_KEY=agent-payment-attempt-0001
# TAPPROVED_RECIPIENT_ID=merchant.testnet
# TAPPROVED_AMOUNT_YOCTO=1000000000000000000000
# Optional USB serial connection to the ESP32; configure locally, never commit device secrets.
# SERIAL_PORT=/dev/ttyUSB0
# SERIAL_PORT=COM7
SERIAL_BAUD_RATE=115200
SERIAL_APPROVAL_TIMEOUT_MS=35000
RECOVERY_MONITOR_INTERVAL_MS=30000
